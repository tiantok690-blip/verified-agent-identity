name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name : chryz11       description: 'lokie'
        required: true
        default: 'lokie'
      agent_description:
        description: 'lokie'
        required: true
        default: 'lokie AI Agent'

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - name : chryz11   uses: actions/checkout@v3

      - name : chryz11 
        uses: actions/setup-node@v3
        with:
          node-version: '20'

      - name : chryz11 nametep 1 - Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity

      - name: chryz11 Install script dependencies
        run: |
          cd scripts
          npm install

      - name:  chryz11 Step 2 - Create new Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js

      - name: chryz11 Step 3 - Link Human to Agent
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "chryz11", "description": "lokie AI Agent"}'
